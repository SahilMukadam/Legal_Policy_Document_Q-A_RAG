# ═══════════════════════════════════════════════════════════
# Legal Document Q&A (RAG) — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
# Only the active provider's key is required.

# ────── LLM Provider ──────
# Options: "gemini" (free) or "anthropic" (paid)
LLM_PROVIDER=gemini

# Google Gemini (free tier — 250 req/day)
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Anthropic Claude (paid — swap in for production/demo)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-claude-api-key-here

# ────── Vector Store Provider ──────
# Options: "chroma" (local, free) or "pinecone" (cloud)
VECTOR_STORE_PROVIDER=chroma

# Pinecone (only needed if VECTOR_STORE_PROVIDER=pinecone)
# Get key: https://app.pinecone.io/
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=legal-doc-qa

# ────── ChromaDB (Local) ──────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=legal_docs

# ────── Embedding Model ──────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ────── Chunking ──────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ────── App ──────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
